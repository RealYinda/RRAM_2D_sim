Main{
  // 日志文件名称.
  log_file_name = "Heat-3d.log"
  log_all_nodes = FALSE

  // 可视化数据场的输出参数.
  javis_dump_interval         = 0               // 输出时间步的间隔. 0表示关闭.
  javis_dump_dirname          = "javis_heat-3d" // 存储数据场的目录名.
  javis_number_procs_per_file = 1               // 多少个进程共享一个输出文件.

  // 重启动控制参数.
  restart_dump_interval = 0                 // 重启动时间步的间隔. 0表示关闭.
  restart_dump_dirname  = "restart_heat-3d" // 存储重启动数据场的目录名.
}

FEM {
  element_type    = "LinearTetrahedron"
  integrator_type = "LinearTetrahedron"
  shape_func_type = "LinearTetrahedron"
  Solver {
    solver_lib      = "JPSol"
    solver_name     = "AMG_CG"
    residual_tol    = 1.0e-18
    max_iter        = 115
    print_iter_info = 2 
    Matrix {
      Matrix_Type = "CSR"
    }
  }	  
  constraint_types = "displacement0"
  constraint_marks = 1
}

GridTopology {
}

GridGeometry {
  MeshImportationParameter{
    //file_name    = "../input/box-3d-28.k"
    file_name    = "../input/box-3d-10000.k"
    refine_times = 0 
  }
}

HierarchyTimeIntegrator{
  // 时间控制参数
  start_time           = 0.e0 // 模拟的初始时刻.
  end_time             = 1.0  // 模拟的终止时刻.
  max_integrator_steps = 1    // 模拟的最大时间步数.
  max_dt               = 1.0  // 最大时间步步长.
  grow_dt              = 1.2  // 连续两个时间步长的最大放大倍数.

  GriddingAlgorithm{
    patch_size = 15000 // 网格片大小.
    refine_times = 0 
  }
}

JaVisDataWriter{
}

TimerManager{
  timer_list   = "*::*::*"
  print_summed = TRUE
  print_max    = TRUE
}
